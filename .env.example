# =========================================================
# SMART ENERGY AI — ENVIRONMENT CONFIGURATION
# =========================================================

# Flask & Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=generate_a_random_secret_key_here

# 2FA Email & Gmail SMTP (SSL: 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_16_char_app_password
SMTP_FROM=your_email@gmail.com

# LLM & RAG (Optional)
# auto picks the first key found: GROQ_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY.
# With no key, data questions are still answered (computed figures, no LLM wording).
RAG_LLM_PROVIDER=auto
# GROQ_API_KEY=
# RAG_LLM_MODEL=openai/gpt-oss-20b
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
